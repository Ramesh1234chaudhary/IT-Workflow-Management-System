# ---------------------------------------------------------------------------
# Server runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database (MongoDB)
# Local:   mongodb://127.0.0.1:27017/it_workflow_management
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>/it_workflow_management?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/it_workflow_management

# ---------------------------------------------------------------------------
# JWT secrets - CHANGE THESE in every environment (use long random values)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_EXPIRES_DAYS=7

# ---------------------------------------------------------------------------
# Cookies / CORS - CLIENT_URL may be a comma separated allow-list
#
# PRODUCTION (Vercel + Railway) requires:
#   CLIENT_URL=https://your-app.vercel.app   the exact SPA origin, no trailing /
#   REFRESH_COOKIE_SAMESITE=none             API is a different *site*, so a Lax
#                                            cookie is never sent on refresh and
#                                            every reload signs the user out
#   REFRESH_COOKIE_SECURE=true               SameSite=None is ignored without it
#   TRUST_PROXY=true                         Railway sits behind a proxy, so req.ip
#                                            is the load balancer otherwise
# Leave COOKIE_DOMAIN blank: host-only cookies work on every provider.
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
REFRESH_COOKIE_NAME=wf_refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Uploads (documents)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ---------------------------------------------------------------------------
# Integrations (Phase 2 stubs - optional, unused when blank)
# ---------------------------------------------------------------------------
OPENPROJECT_BASE_URL=
OPENPROJECT_API_TOKEN=
TIMESHEET_BASE_URL=
TIMESHEET_API_TOKEN=
INTEGRATIONS_ENABLED=false
