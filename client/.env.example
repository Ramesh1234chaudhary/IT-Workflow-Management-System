# ---------------------------------------------------------------------------
# Base URL of the backend API (must include the /api prefix)
# Local:  http://localhost:4000/api
# Vercel: https://your-api.up.railway.app/api
#
# VITE_ vars are baked in at BUILD time, not runtime. On Vercel set this in
# Project Settings > Environment Variables and REDEPLOY - changing it in the
# dashboard alone will not rebuild the bundle.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Optional: display name shown in the app bar
# ---------------------------------------------------------------------------
VITE_APP_NAME=IT Workflow Manager
